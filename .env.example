# Copia questo file in .env e inserisci le tue chiavi API.
# .env NON viene committato (vedi .gitignore).

# Root del vault Obsidian (completate/, da_processare/, .obsidian/).
# Obbligatorio se il codice e il vault si trovano in cartelle separate.
VAULT_ROOT=C:\Users\ABAIO\OneDrive - ICONSULTING S.p.A\Desktop\Call

# Chiave Groq per la trascrizione Whisper (obbligatoria)
GROQ_API_KEY=

# Claude Code CLI: il provider "claude" richiede la CLI `claude` installata e
# autenticata (eseguire `claude auth login` una tantum). Nessuna chiave qui.

# GitHub Copilot SDK usa l'autenticazione Copilot/GitHub disponibile in ambiente.
# Se necessario, valorizzare uno di questi token.
COPILOT_GITHUB_TOKEN=
GITHUB_TOKEN=
